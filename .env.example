# Dashboard login
DASH_USER=admin
DASH_PASS=changeme

# Token required for ingest. Can also be passed in the URL path:
# https://host/<INGEST_TOKEN>/
INGEST_TOKEN=change-this-token

# Optional Postgres (Render Postgres). Leave empty for file storage.
DATABASE_URL=
PGSSL=false

# Optional
PORT=3000
MAX_MESSAGES=5000
